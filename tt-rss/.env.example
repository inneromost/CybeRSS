# Copy to .env and change the passwords.

# Database (internal to the compose network).
TTRSS_DB_USER=postgres
TTRSS_DB_NAME=postgres
TTRSS_DB_PASS=change-me

# Password for the built-in "admin" account, applied on every start.
ADMIN_USER_PASS=change-me

# Where the web UI listens. Keep it on localhost unless you put a
# TLS-terminating reverse proxy in front.
HTTP_PORT=127.0.0.1:8280

# Optional: the user agent sent when fetching feeds. Tiny Tiny RSS identifies
# itself by default, and some sites refuse clients they do not recognise.
# Check a site's terms before presenting as something else.
#TTRSS_HTTP_USER_AGENT=
